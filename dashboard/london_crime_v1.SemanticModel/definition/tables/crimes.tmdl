				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Borough", type text}, {"Month", type date}, {"Crime type", type text}, {"Number of crimes", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

